///|
test "capability registry resolves only DOCX and XLSX aliases" {
  for
    case in [
      ("docx", "docx"),
      ("WORD", "docx"),
      ("xlsx", "xlsx"),
      ("Excel", "xlsx"),
    ] {
    let (alternate, expected) = case
    guard @office.resolve_format_alias(alternate) is Some(format) else {
      fail("expected a format alias: \{alternate}")
    }
    assert_eq(format.name(), expected)
  }
  for unsupported in ["", "ppt", "pptx", "powerpoint", "mcp"] {
    assert_true(@office.resolve_format_alias(unsupported) is None)
  }
}

///|
test "capability registry advertises only implemented commands" {
  let commands = @office.capability_commands()
  let names = commands.map(command => command.name)
  inspect(
    names.join(","),
    content=(
      #|help,identify,outline,get,text,query,find,replace,format,insert-paragraph,delete-paragraph,validate,dump,replay,issues,preview,render,create,template,edit,annotate,batch,raw
    ),
  )
  guard commands[0] is { name: "help", usage, inputs: [query, ..], .. } else {
    fail("expected the declared help command")
  }
  assert_eq(
    usage, "office help [all|schemas|schema <id>|<format>|<operation>|<format> <operation>] [--json|--jsonl]",
  )
  assert_eq(query.name, "query")
  assert_false(usage.contains("element"))
  let help = commands[0]
  assert_eq(help.outputs.length(), 0)
  assert_eq(
    help.variants.map(variant => variant.name).join(","),
    "capabilities,capability-records,schemas,schema",
  )
  assert_eq(
    help.variants.map(variant => variant.result_schema).join(","),
    "office.capabilities/2,office.capability/2,office.input-contracts/1,office.input-contract/1",
  )
  assert_eq(
    help.variants[0].outputs.map(field => field.name).join(","),
    "schema,fingerprint,records,format,operation",
  )
  assert_eq(
    help.variants[1].outputs.map(field => field.name).join(","),
    "schema,fingerprint,kind,name,aliases,description,selector,summary,usage,formats,inputs,outputs,output_modes,variants",
  )
  assert_eq(
    help.variants[2].outputs.map(field => field.name).join(","),
    "schema,fingerprint,contracts",
  )
  assert_eq(
    help.variants[3].outputs.map(field => field.name).join(","),
    "schema,id,fingerprint,summary,consumed_by,envelope,definitions,operations,constraints,limits,examples",
  )
  let inventory = @office.capabilities_data().stringify()
  assert_false(inventory.contains("ppt"))
  assert_false(inventory.contains("mcp"))
  assert_false(inventory.contains("watch"))
  assert_false(inventory.contains("\"name\":\"mutation\""))
}

///|
test "XLSX batch help embeds the exact parser-owned versioned registry" {
  guard @office.find_capability_command("batch") is Some(command) else {
    fail("batch capability must exist")
  }
  assert_true(!command.variants.is_empty())
  let variant = command.variants[0]
  assert_eq(variant.name, "xlsx")
  guard variant.registry is Some(registry) else {
    fail("XLSX batch capability must carry its parser registry")
  }
  assert_eq(registry.stringify(), @batch.capabilities().stringify())
  guard @office.capability_records(format=Xlsx, operation="batch")
    is [Object(record)] &&
    record.get("variants") is Some(Array([Object(serialized)])) &&
    serialized.get("registry") is Some(serialized_registry) else {
    fail("serialized XLSX batch capability must carry its parser registry")
  }
  assert_eq(serialized_registry.stringify(), @batch.capabilities().stringify())
}

///|
test "help variants declare every field their serializers emit" {
  guard @office.find_capability_command("help") is Some(help) else {
    fail("expected help capability")
  }
  fn assert_declared_shape(
    document : Json,
    declared : Array[String],
    required : Array[String],
  ) -> Unit raise {
    guard document is Object(fields) else { fail("expected an object") }
    for name, _ in fields {
      if !declared.contains(name) {
        fail("undeclared output: " + name)
      }
    }
    for name in required {
      if !fields.contains(name) {
        fail("missing required output: " + name)
      }
    }
  }
  let capability_outputs = help.variants[0].outputs
  let capability_names = capability_outputs.map(field => field.name)
  let capability_required = capability_outputs
    .filter(field => field.required)
    .map(field => field.name)
  assert_declared_shape(
    @office.capabilities_data(),
    capability_names,
    capability_required,
  )
  assert_declared_shape(
    @office.capabilities_data(format=Docx, operation="identify"),
    capability_names,
    capability_required,
  )
  let record_outputs = help.variants[1].outputs
  let record_names = record_outputs.map(field => field.name)
  let record_required = record_outputs
    .filter(field => field.required)
    .map(field => field.name)
  for record in @office.capability_records() {
    assert_declared_shape(record, record_names, record_required)
  }
}

///|
test "raw capability variants describe every accepted option and conflict" {
  guard @office.find_capability_command("raw") is Some(raw) else {
    fail("expected raw capability")
  }
  assert_eq(
    raw.variants.map(variant => variant.name).join(","),
    "list,read,replace,edit",
  )
  assert_eq(raw.outputs.length(), 0)
  assert_eq(
    raw.variants.map(variant => variant.result_schema).join(","),
    "office.raw.inventory/1,office.raw.part/1,office.raw.result/1,office.raw.result/1",
  )
  assert_eq(
    raw.variants[0].outputs.map(field => field.name).join(","),
    "format,part_count,parts",
  )
  assert_eq(
    raw.variants[1].outputs.map(field => field.name).join(","),
    "format,part,encoding,content,output",
  )
  for index in [2, 3] {
    assert_eq(
      raw.variants[index].outputs.map(field => field.name).join(","),
      "change,transaction",
    )
    assert_eq(raw.variants[index].outputs[0].type_name, "office.raw.change/1")
    assert_eq(raw.variants[index].outputs[1].type_name, "office.transaction/2")
    assert_true(
      raw.variants[index].constraints.contains(
        "out-extension-must-match-input-format",
      ),
    )
    let mut out_description : String? = None
    for field in raw.variants[index].inputs {
      if field.name == "out" {
        out_description = Some(field.description)
      }
    }
    guard out_description is Some(description) else {
      fail("raw mutation variant must publish its output contract")
    }
    assert_true(description.contains("same .docx or .xlsx extension"))
  }
  assert_eq(
    raw.variants[0].inputs.map(field => field.name).join(","),
    "file,json",
  )
  assert_eq(
    raw.variants[1].inputs.map(field => field.name).join(","),
    "file,part,json,base64,output",
  )
  assert_eq(
    raw.variants[2].inputs.map(field => field.name).join(","),
    "file,part,xml,xml-file,out,dry-run,overwrite,json",
  )
  assert_eq(
    raw.variants[3].inputs.map(field => field.name).join(","),
    "file,part,path,action,xml,xml-file,attribute,value,namespace,all,out,dry-run,overwrite,json",
  )
  assert_true(
    raw.variants[1].constraints.contains("mutually-exclusive(base64,output)"),
  )
  assert_true(raw.variants[2].constraints.contains("exactly-one(xml,xml-file)"))
  assert_true(
    raw.variants[3].constraints.contains(
      "set-attribute-requires(attribute,value)",
    ),
  )
  assert_true(
    raw.variants[3].constraints.contains(
      "flag-looking-values-require-attached-syntax",
    ),
  )
  let actions = raw.variants[3].actions
  assert_eq(
    actions.map(action => action.name).join(","),
    "append,prepend,insert-before,insert-after,replace,remove,set-attribute",
  )
  for index in [0, 1, 2, 3, 4] {
    assert_eq(actions[index].requires, ["exactly-one(xml,xml-file)"])
    assert_eq(actions[index].forbids, ["attribute", "value"])
  }
  assert_eq(actions[5].forbids, ["xml", "xml-file", "attribute", "value"])
  assert_eq(actions[6].requires, ["attribute", "value"])
  assert_eq(actions[6].forbids, ["xml", "xml-file"])
  for index in [2, 3, 5] {
    assert_eq(actions[index].restrictions, [
      "path-must-not-select-document-element",
    ])
  }
  assert_true(
    @office.capabilities_data(operation="raw")
    .stringify()
    .contains("\"result_schema\":\"office.raw.result/1\""),
  )
}

///|
test "capability formats advertise resolved structured reads for DOCX and XLSX" {
  let formats = @office.capability_formats()
  assert_eq(formats.length(), 2)
  assert_eq(formats[0].selector.schema, "office.selector/1")
  assert_eq(formats[0].selector.root, "/docx")
  assert_eq(formats[1].selector.root, "/xlsx")
  assert_eq(formats[0].selector.status, "read-resolved")
  assert_true(formats[0].selector.description.contains("bounded canonical"))
  assert_eq(formats[1].selector.status, "read-resolved")
  assert_true(formats[1].selector.description.contains("bounded canonical"))
  assert_true(formats[0].selector.examples.length() >= 2)
  assert_true(formats[1].selector.examples.length() >= 2)
}

///|
test "structured read capabilities publish both format schemas and enforced bounds" {
  for
    case in [
      ("outline", @office.SCHEMA_DOCX_OUTLINE, @office.SCHEMA_XLSX_OUTLINE),
      ("get", @office.SCHEMA_DOCX_ELEMENT, @office.SCHEMA_XLSX_ELEMENT),
      ("text", @office.SCHEMA_DOCX_TEXT, @office.SCHEMA_XLSX_TEXT),
      ("query", @office.SCHEMA_DOCX_QUERY, @office.SCHEMA_XLSX_QUERY),
    ] {
    let (name, docx_schema, xlsx_schema) = case
    guard @office.find_capability_command(name) is Some(command) else {
      fail("missing command: \{name}")
    }
    assert_eq(command.formats, ["docx", "xlsx"])
    assert_true(command.inputs.any(field => field.name == "max-elements"))
    assert_true(command.inputs.any(field => field.name == "max-output-chars"))
    guard command.outputs.filter(field => field.name == "schema").get(0)
      is Some(schema) else {
      fail("missing schema output: \{name}")
    }
    assert_true(schema.type_name.contains(docx_schema))
    assert_true(schema.type_name.contains(xlsx_schema))
    assert_true(
      command.variants.any(variant => variant.result_schema == docx_schema),
    )
    assert_true(
      command.variants.any(variant => variant.result_schema == xlsx_schema),
    )
  }
  guard @office.find_capability_command("query") is Some(query) else {
    fail("missing query command")
  }
  assert_true(query.inputs.any(field => field.name == "property"))
  assert_true(query.usage.contains("--ignore-case"))
  assert_false(query.usage.to_lower().contains("regex"))
  guard @office.find_capability_command("outline") is Some(outline) else {
    fail("missing outline command")
  }
  for name in ["active_sheet", "sheets", "defined_names", "limits"] {
    assert_true(outline.outputs.any(field => field.name == name))
  }
  guard @office.find_capability_command("get") is Some(get) else {
    fail("missing get command")
  }
  for
    name in [
      "sheet_count", "sheets", "defined_names", "sheet", "cell", "cells", "reference",
      "styles", "scanned_cells", "returned",
    ] {
    assert_true(get.outputs.any(field => field.name == name))
  }
}

///|
test "structured capability variants are self-contained and format exact" {
  for
    case in [
      ("outline", @office.SCHEMA_DOCX_OUTLINE, @office.SCHEMA_XLSX_OUTLINE),
      ("get", @office.SCHEMA_DOCX_ELEMENT, @office.SCHEMA_XLSX_ELEMENT),
      ("text", @office.SCHEMA_DOCX_TEXT, @office.SCHEMA_XLSX_TEXT),
      ("query", @office.SCHEMA_DOCX_QUERY, @office.SCHEMA_XLSX_QUERY),
    ] {
    let (name, docx_schema, xlsx_schema) = case
    guard @office.find_capability_command(name) is Some(command) else {
      fail("missing command: \{name}")
    }
    assert_eq(command.variants.length(), 2)
    let docx = command.variants[0]
    let xlsx = command.variants[1]
    assert_eq(docx.name, "docx")
    assert_eq(xlsx.name, "xlsx")
    assert_true(!docx.inputs.is_empty())
    assert_true(!docx.outputs.is_empty())
    assert_true(!xlsx.inputs.is_empty())
    assert_true(!xlsx.outputs.is_empty())
    guard docx.outputs.filter(field => field.name == "schema").get(0)
      is Some(docx_field) else {
      fail("missing DOCX schema field: \{name}")
    }
    guard xlsx.outputs.filter(field => field.name == "schema").get(0)
      is Some(xlsx_field) else {
      fail("missing XLSX schema field: \{name}")
    }
    assert_eq(docx_field.type_name, "literal(\{docx_schema})")
    assert_eq(xlsx_field.type_name, "literal(\{xlsx_schema})")
    assert_false(
      docx.outputs.any(field => field.description.contains("XLSX only")),
    )
    assert_false(
      xlsx.outputs.any(field => field.description.contains("DOCX only")),
    )
    assert_false(
      docx.inputs.any(field => field.description.contains("XLSX only")),
    )
    assert_false(
      xlsx.inputs.any(field => field.description.contains("DOCX only")),
    )
  }
}

///|
test "format-filtered capability records remove cross-format unions" {
  let docx_records = @office.capability_records(format=Docx).map(record => {
    record.stringify()
  })
  let joined = docx_records.join("\n")
  assert_false(joined.contains("\"formats\":[\"docx\",\"xlsx\"]"))
  assert_false(joined.contains("\"name\":\"xlsx\",\"usage\":"))
  assert_false(joined.contains("XLSX only"))
  assert_true(joined.contains("\"type\":\"literal(docx)\""))
  for record in docx_records {
    if record.contains("\"kind\":\"command\"") {
      assert_true(record.contains("\"formats\":[\"docx\"]"))
    }
  }
}

///|
test "capability registry format filters remain truthful" {
  let records = @office.capability_records(format=Docx)
    .map(record => record.stringify())
    .join("\n")
  inspect(
    records,
    content=(
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"format","name":"docx","aliases":["word"],"description":"WordprocessingML documents","selector":{"schema":"office.selector/1","root":"/docx","status":"read-resolved","examples":["/docx/body/p[1]/r[2]","/docx/body/p[id=\"1A2B3C4D\"]","/docx/comments/comment[id=\"7\"]"],"description":"bounded canonical resolution for outline, get, text, and declared query predicates"}}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"identify","summary":"Identify a structurally valid XLSX or DOCX package","usage":"office identify <file> [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"path to an XLSX or DOCX package"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"file","type":"path","required":true,"description":"the input path exactly as supplied"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"}],"output_modes":["human","json"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"outline","summary":"Summarize bounded XLSX or DOCX structure using canonical selectors","usage":"office outline FILE [--max-elements N] [--max-output-chars N] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"max-elements","type":"integer(1..200000)","required":false,"description":"DOCX projection-node or XLSX cell scan ceiling; default 50000; XLSX effective hard ceiling 100000"},{"name":"max-output-chars","type":"integer(1..4194304)","required":false,"description":"successful stdout ceiling including trailing LF; failure envelopes are separate; default 1048576"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"schema","type":"literal(office.docx.outline/1)","required":true,"description":"format-specific versioned result schema"},{"name":"file","type":"path","required":true,"description":"the input path exactly as supplied"},{"name":"format","type":"literal(docx)","required":true,"description":"resolved document format"},{"name":"scanned_elements","type":"integer","required":false,"description":"DOCX only: number of elements in the bounded projection"},{"name":"counts","type":"object","required":false,"description":"DOCX only: deterministic structural counts across every story"},{"name":"stories","type":"array","required":false,"description":"DOCX only: story roots"},{"name":"headings","type":"array","required":false,"description":"DOCX only: bounded heading previews; each carries the paragraph anchor fields (para_id, paragraph_anchor_status, physical_para_ids)"},{"name":"comments","type":"array","required":false,"description":"DOCX only: comment threads with author, resolved state, parent, and anchor paragraph; done and parent_id appear only when the document records them"},{"name":"revisions","type":"array","required":false,"description":"DOCX only: unaccepted tracked changes with type (ins|del) and the containing paragraph; author, date, and id appear only when the document records them"},{"name":"styles_in_use","type":"array","required":false,"description":"DOCX only: deduplicated referenced styles"},{"name":"images","type":"array","required":false,"description":"DOCX only: image metadata"},{"name":"sections","type":"array","required":false,"description":"DOCX only: section boundaries and header/footer references"},{"name":"diagnostics","type":"array","required":false,"description":"DOCX only: reader and source diagnostics"}],"output_modes":["human","json"],"variants":[{"name":"docx","usage":"office outline FILE","result_schema":"office.docx.outline/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"max-elements","type":"integer(1..200000)","required":false,"description":"DOCX projection-node or XLSX cell scan ceiling; default 50000; XLSX effective hard ceiling 100000"},{"name":"max-output-chars","type":"integer(1..4194304)","required":false,"description":"successful stdout ceiling including trailing LF; failure envelopes are separate; default 1048576"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"schema","type":"literal(office.docx.outline/1)","required":true,"description":"format-specific versioned result schema"},{"name":"file","type":"path","required":true,"description":"the input path exactly as supplied"},{"name":"format","type":"literal(docx)","required":true,"description":"resolved document format"},{"name":"scanned_elements","type":"integer","required":false,"description":"DOCX only: number of elements in the bounded projection"},{"name":"counts","type":"object","required":false,"description":"DOCX only: deterministic structural counts across every story"},{"name":"stories","type":"array","required":false,"description":"DOCX only: story roots"},{"name":"headings","type":"array","required":false,"description":"DOCX only: bounded heading previews; each carries the paragraph anchor fields (para_id, paragraph_anchor_status, physical_para_ids)"},{"name":"comments","type":"array","required":false,"description":"DOCX only: comment threads with author, resolved state, parent, and anchor paragraph; done and parent_id appear only when the document records them"},{"name":"revisions","type":"array","required":false,"description":"DOCX only: unaccepted tracked changes with type (ins|del) and the containing paragraph; author, date, and id appear only when the document records them"},{"name":"styles_in_use","type":"array","required":false,"description":"DOCX only: deduplicated referenced styles"},{"name":"images","type":"array","required":false,"description":"DOCX only: image metadata"},{"name":"sections","type":"array","required":false,"description":"DOCX only: section boundaries and header/footer references"},{"name":"diagnostics","type":"array","required":false,"description":"DOCX only: reader and source diagnostics"}],"constraints":["format=docx"],"actions":[],"output_modes":["human","json"]}]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"get","summary":"Resolve one canonical XLSX or DOCX selector","usage":"office get FILE SELECTOR [--max-elements N] [--max-output-chars N] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"selector","type":"office.selector/1","required":true,"description":"canonical selector matching the validated package format"},{"name":"max-elements","type":"integer(1..200000)","required":false,"description":"DOCX projection-node or XLSX cell scan ceiling; default 50000; XLSX effective hard ceiling 100000"},{"name":"max-output-chars","type":"integer(1..4194304)","required":false,"description":"successful stdout ceiling including trailing LF; failure envelopes are separate; default 1048576"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"schema","type":"literal(office.docx.element/1)","required":true,"description":"format-specific versioned result schema"},{"name":"file","type":"path","required":true,"description":"the input path exactly as supplied"},{"name":"format","type":"literal(docx)","required":true,"description":"resolved document format"},{"name":"path","type":"office.selector/1","required":true,"description":"resolved canonical path"},{"name":"kind","type":"string","required":true,"description":"resolved workbook, sheet, coordinate, story, annotation, or element kind"},{"name":"role","type":"enum(story-root|annotation-collection|annotation-item|element)","required":false,"description":"DOCX only: projection role"},{"name":"stability","type":"enum(stable|snapshot-relative)","required":true,"description":"selector stability classification"},{"name":"source","type":"object","required":false,"description":"DOCX only: physical story source metadata"},{"name":"parent","type":"office.selector/1","required":false,"description":"canonical parent path; absent for projection roots"},{"name":"id","type":"string","required":false,"description":"the entry's stable id: an annotation id, or a soundly-joined UNIQUE paragraph's canonical w14:paraId — resolvable back via p[id=\"…\"]; duplicates never earn one"},{"name":"para_id","type":"string","required":false,"description":"DOCX paragraph entries only: canonical w14:paraId, null unless the paragraph carries a valid one"},{"name":"paragraph_anchor_status","type":"string","required":false,"description":"DOCX paragraph entries only: unique|missing|invalid|duplicate|multi_physical|unjoined — unjoined means no sound tree/projection correspondence exists, so no identity is claimed"},{"name":"physical_para_ids","type":"array","required":false,"description":"DOCX paragraph entries only: non-null only for multi_physical — the participating paragraphs' valid ids, bounded"},{"name":"children","type":"array","required":false,"description":"DOCX only: addressable direct children (paragraph child references carry the anchor fields too)"},{"name":"properties","type":"object","required":false,"description":"DOCX only: declared formatting and element summary"},{"name":"metadata","type":"object","required":false,"description":"DOCX only: role-specific metadata"},{"name":"text","type":"string","required":false,"description":"DOCX only: bounded raw text projection"}],"output_modes":["human","json"],"variants":[{"name":"docx","usage":"office get FILE /docx/...","result_schema":"office.docx.element/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"selector","type":"office.selector/1","required":true,"description":"canonical selector matching the validated package format"},{"name":"max-elements","type":"integer(1..200000)","required":false,"description":"DOCX projection-node or XLSX cell scan ceiling; default 50000; XLSX effective hard ceiling 100000"},{"name":"max-output-chars","type":"integer(1..41