UE at the reported path before publication. Nothing is published on any refusal"}],"constraints":["format=docx"],"actions":[],"output_modes":["human","json"]}]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"delete-paragraph","summary":"Delete one direct body paragraph, refusing wherever the removal would dangle document state","usage":"office delete-paragraph FILE OUT.docx --at (p[N] | p[id=\"…\"]) [--expect-text TEXT] [--dry-run] [--overwrite] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, nothing written on any refusal"},{"name":"at","type":"string","required":true,"description":"the DIRECT body paragraph to delete: p[3] (proven a physical child of the body on the element tree), or stable p[id=\"…\"] resolved against the transaction snapshot with the typed para_id refusals"},{"name":"expect-text","type":"string","required":false,"description":"assert the target's full projection equals this text before deleting; a mismatch refuses with nothing written — the guard against deleting the wrong paragraph by ordinal"},{"name":"dry-run","type":"boolean","required":false,"description":"run the identical resolve/plan/validate pipeline, exit as the real run would, write nothing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"schema","type":"literal(office.docx.delete-paragraph/1)","required":true,"description":"deletion result schema"},{"name":"file","type":"string","required":true,"description":"the edited source path"},{"name":"format","type":"literal(docx)","required":true,"description":"edited document format"},{"name":"output","type":"string","required":true,"description":"the publication destination"},{"name":"at","type":"string","required":true,"description":"the target as requested"},{