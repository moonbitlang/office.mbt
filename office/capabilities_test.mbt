      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"find","summary":"List every literal text candidate in a DOCX, with whether an edit there is allowed","usage":"office find FILE --text TEXT [--in PATH] [--limit N] [--context N] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified)"},{"name":"text","type":"string","required":true,"description":"literal text to find — never a regular expression or wildcard; matched over the reader PROJECTION, so it spans run boundaries"},{"name":"in","type":"string","required":false,"description":"restrict to a body-relative subtree by path prefix (p[3], tbl[1]) or by stable identity: p[id=\"1A2B3C4D\"] resolves through the anchor judge and refuses ambiguous, buried, absent, or invalid ids — never first-wins"},{"name":"limit","type":"integer","required":false,"description":"maximum returned candidates (default 100, hard limit 1000)"},{"name":"context","type":"integer","required":false,"description":"projection characters of context each side (default 24, maximum 200)"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"schema","type":"literal(office.docx.matches/1)","required":true,"description":"match result schema"},{"name":"file","type":"string","required":true,"description":"the searched path"},{"name":"format","type":"literal(docx)","required":true,"description":"searched document format"},{"name":"text","type":"string","required":true,"description":"the literal that was searched for"},{"name":"in","type":"string","required":false,"description":"the subtree restriction, null when unrestricted"},{"name":"stories_scanned","type":"array(string)","required":true,"description":"the stories searched; /body in v1"},{"name":"matches","type":"array(object)","required":true,"description":"per candidate: ordinal, story, path, range {start, end, unit=utf16} paragraph-relative over the PROJECTION, text, context_before, context_after, runs (affected run paths), source_kinds (text|tab|no-break-hyphen|soft-hyphen|symbol), actionable, reason (null when actionable), para_id (canonical uppercase w14:paraId, null unless the paragraph carries a valid one), paragraph_anchor_status (unique|missing|invalid|duplicate|multi_physical — anchor health is a separate dimension from actionable; multi_physical means NO one-to-one logical/physical mapping, whether revision-joined from several w:p or sharing one w:p with another logical paragraph), and physical_para_ids (non-null only for multi_physical: the participating paragraphs' valid ids, bounded). `actionable` reports whether the RANGE is structurally editable — regions, ancestry, boundaries, carriers — NOT that any given replacement will be accepted; validity of the new text belongs to the write, so a replacement carrying a control character is still refused over an actionable range"},{"name":"matches_total","type":"integer","required":true,"description":"candidates that EXIST in the searched stories, counted whether or not --limit examined them"},{"name":"actionable_returned","type":"integer","required":true,"description":"of the RETURNED entries, how many a partial edit would be permitted over. Counted over the returned page rather than the document, because a candidate past --limit is never offered to the planner and so has no verdict"},{"name":"unactionable_returned","type":"integer","required":true,"description":"of the RETURNED entries, how many exist but must not be rewritten"},{"name":"truncated","type":"boolean","required":true,"description":"whether --limit omitted later candidates"}],"output_modes":["human","json"],"variants":[{"name":"docx","usage":"office find FILE --text TEXT [--in PATH]","result_schema":"office.docx.matches/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified)"},{"name":"text","type":"string","required":true,"description":"literal text to find — never a regular expression or wildcard; matched over the reader PROJECTION, so it spans run boundaries"},{"name":"in","type":"string","required":false,"description":"restrict to a body-relative subtree by path prefix (p[3], tbl[1]) or by stable identity: p[id=\"1A2B3C4D\"] resolves through the anchor judge and refuses ambiguous, buried, absent, or invalid ids — never first-wins"},{"name":"limit","type":"integer","required":false,"description":"maximum returned candidates (default 100, hard limit 1000)"},{"name":"context","type":"integer","required":false,"description":"projection characters of context each side (default 24, maximum 200)"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"schema","type":"literal(office.docx.matches/1)","required":true,"description":"match result schema"},{"name":"file","type":"string","required":true,"description":"the searched path"},{"name":"format","type":"literal(docx)","required":true,"description":"searched document format"},{"name":"text","type":"string","required":true,"description":"the literal that was searched for"},{"name":"in","type":"string","required":false,"description":"the subtree restriction, null when unrestricted"},{"name":"stories_scanned","type":"array(string)","required":true,"description":"the stories searched; /body in v1"},{"name":"matches","type":"array(object)","required":true,"description":"per candidate: ordinal, story, path, range {start, end, unit=utf16} paragraph-relative over the PROJECTION, text, context_before, context_after, runs (affected run paths), source_kinds (text|tab|no-break-hyphen|soft-hyphen|symbol), actionable, reason (null when actionable), para_id (canonical uppercase w14:paraId, null unless the paragraph carries a valid one), paragraph_anchor_status (unique|missing|invalid|duplicate|multi_physical — anchor health is a separate dimension from actionable; multi_physical means NO one-to-one logical/physical mapping, whether revision-joined from several w:p or sharing one w:p with another logical paragraph), and physical_para_ids (non-null only for multi_physical: the participating paragraphs' valid ids, bounded). `actionable` reports whether the RANGE is structurally editable — regions, ancestry, boundaries, carriers — NOT that any given replacement will be accepted; validity of the new text belongs to the write, so a replacement carrying a control character is still refused over an actionable range"},{"name":"matches_total","type":"integer","required":true,"description":"candidates that EXIST in the searched stories, counted whether or not --limit examined them"},{"name":"actionable_returned","type":"integer","required":true,"description":"of the RETURNED entries, how many a partial edit would be permitted over. Counted over the returned page rather than the document, because a candidate past --limit is never offered to the planner and so has no verdict"},{"name":"unactionable_returned","type":"integer","required":true,"description":"of the RETURNED entries, how many exist but must not be rewritten"},{"name":"truncated","type":"boolean","required":true,"description":"whether --limit omitted later candidates"}],"constraints":["format=docx"],"actions":[],"output_modes":["human","json"]}]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"replace","summary":"Replace literal text in a DOCX, refusing wherever an edit would not survive","usage":"office replace FILE OUT.docx --text TEXT --with TEXT [--in PATH] [--nth K] [--expect N] [--allow-zero] [--dry-run] [--overwrite] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, nothing written on any refusal"},{"name":"text","type":"string","required":true,"description":"literal text to replace — never a regular expression or wildcard; matched over the reader PROJECTION, so it spans run boundaries"},{"name":"with","type":"string","required":true,"description":"replacement text; empty deletes the match. Control characters including tab and newline are rejected — v1 makes no breaks or tabs from text"},{"name":"in","type":"string","required":false,"description":"restrict to a body-relative subtree by path prefix (p[3], tbl[1]) or by stable identity: p[id=\"1A2B3C4D\"] resolves against the transaction snapshot with the typed para_id refusals; the report then records resolved_in"},{"name":"nth","type":"integer","required":false,"description":"select ONE candidate by the ordinal `office find` reports (1-based, counted over ALL candidates including restricted ones); selecting a restricted candidate refuses naming its reason"},{"name":"expect","type":"integer","required":false,"description":"assert exactly N replacements are selected; a mismatch refuses with nothing written. Contradicts --allow-zero"},{"name":"allow-zero","type":"boolean","required":false,"description":"treat zero matches as success instead of refusing"},{"name":"dry-run","type":"boolean","required":false,"description":"run the identical selection and preflight pipeline, exit as the real run would, write nothing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"schema","type":"literal(office.docx.replace/1)","required":true,"description":"replace result schema"},{"name":"file","type":"string","required":true,"description":"the edited source path"},{"name":"format","type":"literal(docx)","required":true,"description":"edited document format"},{"name":"output","type":"string","required":true,"description":"the publication destination"},{"name":"text","type":"string","required":true,"description":"the literal that was replaced (bounded)"},{"name":"with","type":"string","required":true,"description":"the replacement text (bounded)"},{"name":"in","type":"string","required":false,"description":"the subtree restriction, null when unrestricted"},{"name":"nth","type":"integer","required":false,"description":"the selected ordinal, null when all candidates were selected"},{"name":"expect","type":"integer","required":false,"description":"the asserted count, null when not asserted"},{"name":"allow_zero","type":"boolean","required":true,"description":"whether zero matches was permitted"},{"name":"resolved_in","type":"string","required":false,"description":"the scan path a stable p[id=\"…\"] scope resolved to; null when the scope was ordinal or absent"},{"name":"dry_run","type":"boolean","required":true,"description":"whether this run validated without publishing"},{"name":"selected","type":"array(integer)","required":true,"description":"the replaced candidates' ordinals — the same ordinals `office find` reports"},{"name":"replaced","type":"integer","required":true,"description":"how many occurrences were replaced"},{"name":"affected","type":"array(string)","required":true,"description":"the affected paragraphs' body-relative paths; each was read back after the splice and its FULL projection compared against the plan-time expectation"},{"name":"affected_paragraphs","type":"array(object)","required":true,"description":"the same paragraphs with stable identity: path, para_id (canonical w14:paraId or null), and paragraph_anchor_status — the anchors to re-address by once ordinal paths go stale"},{"name":"matches","type":"array(object)","required":true,"description":"the SELECTED candidates in find's entry shape (ordinal, path, range, text, context, runs, source_kinds, actionable, reason, para_id, paragraph_anchor_status, physical_para_ids) — the matches payload a dry-run prints, emitted on every run; at most 100 entries"},{"name":"matches_truncated","type":"boolean","required":true,"description":"whether the matches array omitted selected candidates beyond the 100-entry bound; selected and replaced still count them all"},{"name":"changed","type":"boolean","required":true,"description":"whether any byte changed"},{"name":"stories_scanned","type":"array(string)","required":true,"description":"the stories searched; /body in v1"},{"name":"transaction","type":"object","required":true,"description":"office.transaction/2 report; preservation is authoritative, candidates are validated strictly, and the replace readback re-reads every affected paragraph before publication. Nothing is published on any refusal"}],"output_modes":["human","json"],"variants":[{"name":"docx","usage":"office replace FILE OUT.docx --text TEXT --with TEXT","result_schema":"office.docx.replace/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, nothing written on any refusal"},{"name":"text","type":"string","required":true,"description":"literal text to replace — never a regular expression or wildcard; matched over the reader PROJECTION, so it spans run boundaries"},{"name":"with","type":"string","required":true,"description":"replacement text; empty deletes the match. Control characters including tab and newline are rejected — v1 makes no breaks or tabs from text"},{"name":"in","type":"string","required":false,"description":"restrict to a body-relative subtree by path prefix (p[3], tbl[1]) or by stable identity: p[id=\"1A2B3C4D\"] resolves against the transaction snapshot with the typed para_id refusals; the report then records resolved_in"},{"name":"nth","type":"integer","required":false,"description":"select ONE candidate by the ordinal `office find` reports (1-based, counted over ALL candidates including restricted ones); selecting a restricted candidate refuses naming its reason"},{"name":"expect","type":"integer","required":false,"description":"assert exactly N replacements are selected; a mismatch refuses with nothing written. Contradicts --allow-zero"},{"name":"allow-zero","type":"boolean","required":false,"description":"treat zero matches as success instead of refusing"},{"name":"dry-run","type":"boolean","required":false,"description":"run the identical selection and preflight pipeline, exit as the real run would, write nothing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"schema","type":"literal(office.docx.replace/1)","required":true,"description":"replace result schema"},{"name":"file","type":"string","required":true,"description":"the edited source path"},{"name":"format","type":"literal(docx)","required":true,"description":"edited document format"},{"name":"output","type":"string","required":true,"description":"the publication destination"},{"name":"text","type":"string","required":true,"description":"the literal that was replaced (bounded)"},{"name":"with","type":"string","required":true,"description":"the replacement text (bounded)"},{"name":"in","type":"string","required":false,"description":"the subtree restriction, null when unrestricted"},{"name":"nth","type":"integer","required":false,"description":"the selected ordinal, null when all candidates were selected"},{"name":"expect","type":"integer","required":false,"description":"the asserted count, null when not asserted"},{"name":"allow_zero","type":"boolean","required":true,"description":"whether zero matches was permitted"},{"name":"resolved_in","type":"string","required":false,"description":"the scan path a stable p[id=\"…\"] scope resolved to; null when the scope was ordinal or absent"},{"name":"dry_run","type":"boolean","required":true,"description":"whether this run validated without publishing"},{"name":"selected","type":"array(integer)","required":true,"description":"the replaced candidates' ordinals — the same ordinals `office find` reports"},{"name":"replaced","type":"integer","required":true,"description":"how many occurrences were replaced"},{"name":"affected","type":"array(string)","required":true,"description":"the affected paragraphs' body-relative paths; each was read back after the splice and its FULL projection compared against the plan-time expectation"},{"name":"affected_paragraphs","type":"array(object)","required":true,"description":"the same paragraphs with stable identity: path, para_id (canonical w14:paraId or null), and paragraph_anchor_status — the anchors to re-address by once ordinal paths go stale"},{"name":"matches","type":"array(object)","required":true,"description":"the SELECTED candidates in find's entry shape (ordinal, path, range, text, context, runs, source_kinds, actionable, reason, para_id, paragraph_anchor_status, physical_para_ids) — the matches payload a dry-run prints, emitted on every run; at most 100 entries"},{"name":"matches_truncated","type":"boolean","required":true,"description":"whether the matches array omitted selected candidates beyond the 100-entry bound; selected and replaced still count them all"},{"name":"changed","type":"boolean","required":true,"description":"whether any byte changed"},{"name":"stories_scanned","type":"array(string)","required":true,"description":"the stories searched; /body in v1"},{"name":"transaction","type":"object","required":true,"description":"office.transaction/2 report; preservation is authoritative, candidates are validated strictly, and the replace readback re-reads every affected paragraph before publication. Nothing is published on any refusal"}],"constraints":["format=docx"],"actions":[],"output_modes":["human","json"]}]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"format","summary":"Apply direct character formatting to selected text in a DOCX, refusing wherever the result could differ from the request","usage":"office format FILE OUT.docx (--text TEXT [--in PATH] [--nth K] | --range START:END --in P) [--bold on|off] [--italic on|off] [--underline on|off] [--color RRGGBB] [--expect N] [--allow-zero] [--dry-run] [--overwrite] [--json]  (at least one property flag)","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, nothing written on any refusal"},{"name":"text","type":"string","required":false,"description":"literal text to format — never a regular expression; matched over the reader PROJECTION, so it spans run boundaries. Every occurrence is selected unless --nth narrows it. Exactly one of --text / --range"},{"name":"range","type":"string","required":false,"description":"paragraph-local unit range START:END (half-open, the units the read surfaces report); requires --in naming ONE paragraph. Exactly one of --text / --range"},{"name":"in","type":"string","required":false,"description":"restrict to a body-relative subtree (p[3], tbl[1]) or a stable p[id=\"…\"] resolved against the transaction snapshot; the report then records resolved_in"},{"name":"nth","type":"integer","required":false,"description":"select ONE text occurrence by ordinal (1-based)"},{"name":"bold","type":"string","required":false,"description":"on|off — set or clear bold explicitly; an omitted property is left untouched, everywhere"},{"name":"italic","type":"string","required":false,"description":"on|off — set or clear italic"},{"name":"underline","type":"string","required":false,"description":"on|off — set or clear single underline"},{"name":"color","type":"string","req