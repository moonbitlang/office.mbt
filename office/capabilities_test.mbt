      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"insert-paragraph","summary":"Insert one resource-free paragraph beside a direct body paragraph, minting its stable identity","usage":"office insert-paragraph FILE OUT.docx (--before P|--after P) --content JSON [--dry-run] [--overwrite] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, nothing written on refusal"},{"name":"before","type":"string","required":false,"description":"insert before this DIRECT body paragraph (p[3]); exclusive with --after"},{"name":"after","type":"string","required":false,"description":"insert after this DIRECT body paragraph (p[3]); exclusive with --before"},{"name":"content","type":"docx.paragraph/1","required":true,"description":"the dedicated payload: optional \"style\" (a paragraph style id the TARGET's styles part must define, else refuse naming it) and \"runs\" of {text, bold?, italic?, underline?} — resource-free only. Hyperlinks, images, notes, and list bullets are v1 refusals; run text rejects control characters"},{"name":"dry-run","type":"boolean","required":false,"description":"run the identical mint/plan/validate pipeline, exit as the real run would, write nothing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"schema","type":"literal(office.docx.insert-paragraph/1)","required":true,"description":"result schema"},{"name":"file","type":"path","required":true,"description":"the input path exactly as supplied"},{"name":"format","type":"literal(docx)","required":true,"description":"the edited format"},{"name":"output","type":"path","required":true,"de