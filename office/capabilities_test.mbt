e":"array","required":false,"description":"DOCX paragraph entries only: non-null only for multi_physical — the participating paragraphs' valid ids, bounded"},{"name":"children","type":"array","required":false,"description":"DOCX only: addressable direct children (paragraph child references carry the anchor fields too)"},{"name":"properties","type":"object","required":false,"description":"DOCX only: declared formatting and element summary"},{"name":"metadata","type":"object","required":false,"description":"DOCX only: role-specific metadata"},{"name":"text","type":"string","required":false,"description":"DOCX only: bounded raw text projection"}],"constraints":["format=docx"],"actions":[],"output_modes":["human","json"]}]}
