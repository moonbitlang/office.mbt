      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"validate","summary":"Validate an XLSX or DOCX package with the shared mutation gate","usage":"office validate FILE [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.validate/1)","required":true,"description":"versioned validate result schema"},{"name":"file","type":"path","required":true,"description":"the input path, bounded"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"},{"name":"valid","type":"boolean","required":true,"description":"true when the shared package gate reported no errors"},{"name":"findings","type":"array(office.finding/1)","required":true,"description":"bounded office.finding/1 records with severity, code, and message"},{"name":"error_count","type":"integer","required":true,"description":"number of error findings"},{"name":"warning_count","type":"integer","required":true,"description":"number of warning findings"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"dump","summary":"Dump an XLSX or DOCX package as a replayable office.dump/1 op stream","usage":"office dump FILE [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"json","type":"boolean","required":false,"description":"emit the office.dump/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit the streaming office.dump/1 JSONL form"}],"outputs":[{"name":"schema","type":"literal(office.dump/1)","required":true,"description":"versioned replayable dump schema"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"},{"name":"source","type":"object","required":true,"description":"bounded input path, byte count, and sha256 digest (excluded from fixpoint comparison)"},{"name":"replay","type":"object","required":true,"description":"batch schema, create parameters, and engine limits for replay"},{"name":"ops","type":"array","required":true,"description":"ordered canonical versioned batch ops in engine JSON shapes"},{"name":"assets","type":"object","required":true,"description":"content-addressed binaries: sha256-<hex> id to {content_type, size, data} inline base64 under per-asset and total allowances"},{"name":"residual","type":"array","required":true,"description":"ordered machine-readable records of content not expressible as ops"},{"name":"warnings","type":"array","required":true,"description":"bounded dump diagnostics"},{"name":"stats","type":"object","required":true,"description":"op/asset/residual/warning counts"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"replay","summary":"Replay an office.dump/1 document into an XLSX or DOCX package","usage":"office replay FILE --output OUT [--overwrite] [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing office.dump/1 JSON document"},{"name":"output","type":"path","required":true,"description":"destination file matching the dump format (.xlsx or .docx); created atomically, refused when present unless --overwrite"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination (remove-then-stage; not a single atomic swap)"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.replay/1)","required":true,"description":"versioned replay result schema"},{"name":"format","type":"literal(docx)","required":true,"description":"the replayed package format"},{"name":"output","type":"path","required":true,"description":"the published workbook path, bounded"},{"name":"bytes_written","type":"integer","required":true,"description":"exact published byte count"},{"name":"ops_applied","type":"integer","required":true,"description":"number of dump ops replayed"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"issues","summary":"Report bounded actionable findings for an XLSX or DOCX package","usage":"office issues FILE [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.issues/1)","required":true,"description":"versioned issues result schema"},{"name":"file","type":"path","required":true,"description":"the input path, bounded"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"},{"name":"valid","type":"boolean","required":true,"description":"true when the shared package gate reported no errors"},{"name":"findings","type":"array(office.finding/1)","required":true,"description":"bounded office.finding/1 records; XLSX cached formula errors and DOCX reader diagnostics are warnings"},{"name":"error_count","type":"integer","required":true,"description":"number of error findings"},{"name":"warning_count","type":"integer","required":true,"description":"number of warning findings"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"preview","summary":"Render a deterministic offline HTML preview with inline assets","usage":"office preview FILE --output OUT.html [--overwrite] [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"output","type":"path","required":true,"description":"destination .html file; created atomically, refused when present unless --overwrite"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination (remove-then-stage; not a single atomic swap)"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.preview/1)","required":true,"description":"versioned preview result schema"},{"name":"file","type":"path","required":true,"description":"the input path, bounded"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"},{"name":"output","type":"path","required":true,"description":"the published preview path, bounded"},{"name":"bytes_written","type":"integer","required":true,"description":"exact published byte count"},{"name":"charts_rendered","type":"integer","required":true,"description":"charts rendered as inline SVG"},{"name":"charts_placeholder","type":"integer","required":true,"description":"charts kept as labeled placeholders"},{"name":"images_embedded","type":"integer","required":true,"description":"images embedded as data URIs"},{"name":"truncation","type":"object","required":true,"description":"row/column caps, truncated sheet names, and omitted image count"},{"name":"warnings","type":"array","required":false,"description":"bounded converter warnings"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"render","summary":"Lay out a DOCX and draw it as paginated PDF or SVG","usage":"office render FILE --output OUT.(pdf|svg) [--pages RANGE] [--overwrite] [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing DOCX package"},{"name":"output","type":"path","required":true,"description":"destination path; the extension selects the backend (.pdf or .svg). Created atomically, refused when present unless --overwrite. A multi-page SVG render writes <stem>-<n>.svg per page and publishes each file individually. Destinations are checked before any page is drawn, so an occupied path normally refuses with nothing written -- but that is a check and not a lock, and --overwrite skips it, so a later failure can still leave earlier pages published. Publication across the set does not roll back; when anything has landed the refusal is office.render.partial_publication and lists those paths under details.published"},{"name":"pages","type":"string","required":false,"description":"pages to render: 1-based numbers and N-M ranges separated by commas, e.g. `3`, `2-5`, `1,4-6`. Normalized to ascending order with duplicates removed, so a page is never published twice. Omitted renders every page, subject to the same 2048-page ceiling"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination (remove-then-stage; not a single atomic swap)"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.render/1)","required":true,"description":"versioned render result schema"},{"name":"file","type":"path","required":true,"description":"the input path, bounded"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"},{"name":"backend","type":"enum(pdf|svg)","required":true,"description":"the emitter selected by the output extension"},{"name":"outputs","type":"array(object{path:path,bytes_written:integer})","required":true,"description":"every published artifact in page order; one entry for PDF, one per rendered page for multi-page SVG"},{"name":"bytes_written","type":"integer","required":true,"description":"total bytes published across every artifact, accumulated in 64-bit. One artifact may not exceed 64 MiB and the set may not exceed 256 MiB; either ceiling refuses with office.docx.resource_limit"},{"name":"pages_rendered","type":"integer","required":true,"description":"pages actually drawn, after --pages selection"},{"name":"pages_total","type":"integer","required":true,"description":"pages the whole document laid out to, before selection"},{"name":"page_width_pt","type":"number","required":true,"description":"first rendered page width in points"},{"name":"page_height_pt","type":"number","required":true,"description":"first rendered page height in points"},{"name":"fonts_used","type":"integer","required":true,"description":"distinct faces the rendered pages actually reference, counted over the selected pages rather than over the document. PDF embeds a subset of each; SVG only names them in font-family and embeds nothing, so this is a usage count and not an embedding count"},{"name":"images_dropped","type":"integer","required":true,"description":"image occurrences the PDF backend could not embed, summed across reasons rather than counted as distinct reasons. Always 0 for SVG, which embeds every image as a data URI and therefore drops none -- not because it carries no image data"},{"name":"unsupported","type":"array(string)","required":true,"description":"bounded notices the layout frontend recorded for content it could not represent, each truncated to 512 characters. This is what the frontend chose to record, not a proof of completeness: some drops are still silent, floating drawings whose relationship does not resolve among them"},{"name":"unsupported_total","type":"integer","required":true,"description":"notices before bounding"},{"name":"byte_determinism","type":"enum(per-runtime|cross-runtime)","required":true,"description":"PDF is per-runtime: identical on one runtime, not across native and wasm, because the deflate implementation differs by backend. The document is identical either way -- same pages, same glyph positions, same embedded font subset. SVG is cross-runtime, being uncompressed"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"create","summary":"Create a validated Office document atomically","usage":"office create (xlsx OUTPUT [--sheet NAME] | docx OUTPUT) [--dry-run] [--overwrite] [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"format","type":"literal(docx)","required":true,"description":"document format subcommand"}],"outputs":[],"output_modes":["human","json"],"variants":[{"name":"docx","usage":"office create docx OUTPUT [--dry-run] [--overwrite] [--json]","result_schema":"office.docx.create/1","inputs":[{"name":"output","type":"path","required":true,"description":"new .docx destination"},{"name":"dry-run","type":"boolean","required":false,"description":"validate without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"atomically replace an existing regular-file destination"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"transaction","type":"office.transaction/2","required":true,"description":"validation, preservation, and publication report"}],"constraints":["format=docx","output-extension=.docx","create-new-by-default","transactional-publication","bounded-candidate-package","blank-document-only"],"actions":[],"output_modes":["human","json"]}]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"template","summary":"Merge strict {{key}} template data into an XLSX or DOCX document","usage":"office template FILE DATA.json --out OUT [--dry-run] [--overwrite] [--allow-missing] [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX template package (never modified)"},{"name":"data","type":"path","required":true,"description":"office.template.data/1 JSON document. Template text uses {{key}}, where key matches [A-Za-z_][A-Za-z0-9_.-]{0,63}; \\{{ emits a literal {{. Examples: XLSX cell `Invoice for {{customer}}`; DOCX text `Prepared for {{customer}}`. Data contains flat `values` (string/number/bool) plus an optional `regions` map cloning a marked template row once per record; XLSX accepts {sheet,row}, while DOCX accepts only a body-table {path}"},{"name":"out","type":"path","required":true,"description":"destination matching the template format; created atomically, refused when present unless --overwrite"},{"name":"dry-run","type":"boolean","required":false,"description":"run the full merge and validation without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"allow-missing","type":"boolean","required":false,"description":"keep unresolved placeholders as literals instead of failing"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.template/1)","required":true,"description":"versioned template merge result schema"},{"name":"replaced","type":"number","required":true,"description":"placeholders substituted"},{"name":"missing","type":"array(finding)","required":true,"description":"unresolved keys with canonical locations (Sheet1!B2 or /docx/body/p[3]; bounded)"},{"name":"unused","type":"array(string)","required":true,"description":"data keys the template never used (bounded)"},{"name":"regions","type":"array(object)","required":true,"description":"per repeated region: name, source_location, records, replaced (bounded). XLSX clones a marked row through the atomic grid-bounded insert and refuses any formula-bearing workbook; DOCX clones a marked table row through a fail-closed element/attribute whitelist, stripping w14 paragraph ids. Empty when the data document declares no regions"},{"name":"transaction","type":"object","required":true,"description":"office.transaction/2 report; preservation is authoritative. XLSX: values land through literal cell setters (a leading = can never become a formula), formula and rich-text cells are refused contexts, whole-cell placeholders keep the data value's type. DOCX: byte-span run rewrites preserve all unrelated OOXML; values inherit the starting run's formatting; body, header, and footer stories are scanned"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"edit","summary":"Replace literal text or accept/reject tracked changes in an existing DOCX through a strict edit script","usage":"office edit FILE SCRIPT.json --out OUT.docx [--dry-run] [--overwrite] [--allow-unmatched] [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"script","type":"docx.edit/1-or-2-file","required":true,"description":"strict replace_text OR accept_revision/reject_revision OR (schema docx.edit/2) set_run_text script; a script never mixes operation families. set_run_text: `at` is the body-relative run path from `office query` (`p[3]/r[2]`) or a stable head (`p[id=\"1A2B3C4D\"]/r[2]`, identity-judged at transaction time), `expect` must equal the run's current full text (stale expectations refuse; addresses are snapshot-relative), `text` replaces the run's whole text; setting a run's text to itself validates and changes nothing. replace_text: `find` is LITERAL text — never a regular expression or wildcard — matched across run boundaries; `replace` may be empty to delete the matched text; `occurrence` omitted replaces every occurrence in document order, `occurrence: N` replaces only the Nth. accept_revision/reject_revision select tracked changes by `id` (the stable w:id handle), `author`, `type` (ins|del), or `all: true`; spelled selector fields are conjunctive"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, refused when present unless --overwrite"},{"name":"dry-run","type":"boolean","required":false,"description":"run the full edit and validation without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"allow-unmatched","type":"boolean","required":false,"description":"report operations that found too few occurrences instead of refusing"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.docx.edit/1) | literal(office.docx.edit/2)","required":true,"description":"versioned edit result schema, matching the script's schema version"},{"name":"file","type":"string","required":true,"description":"the edited source path"},{"name":"format","type":"literal(docx)","required":true,"description":"edited document format"},{"name":"script_file","type":"string","required":true,"description":"the consumed script path"},{"name":"output","type":"string","required":true,"description":"the publication destination"},{"name":"ops_applied","type":"number","required":true,"description":"operations in the script"},{"name":"replacements","type":"number","required":true,"description":"text spans rewritten across every operation; always 0 for a revision script"},{"name":"revisions_resolved","type":"number","required":true,"description":"distinct tracked changes accepted or rejected; always 0 for a replace_text script"},{"name":"results","type":"array(object)","required":true,"description":"per op: op, find, replace, occurrence, selector, matched, replacements, resolved — all bounded, with one fixed key set per schema version; docx.edit/2 results additionally carry at, expect, and text on EVERY entry (null when inapplicable), plus resolved_at ONLY on a set_run_text entry whose stable head resolved — the one conditional key. A replace_text entry nulls selector; a revision entry nulls find, replace, and occurrence and carries selector {id, author, type, all}; a set_run_text entry nulls find, replace, occurrence, and selector and carries at/expect/text with matched (address resolved) and replacements (spans rewritten)"},{"name":"unmatched","type":"array(finding)","required":true,"description":"operations that found fewer occurrences than they require, or revision selectors that matched no tracked change (bounded); refuses unless --allow-unmatched"},{"name":"unmatched_total","type":"number","required":true,"description":"unmatched operations before bounding"},{"name":"unsupported","type":"array(finding)","required":true,"description":"matches the edit cannot rewrite safely — content a byte-span run rewrite cannot own, matches crossing a hyperlink boundary, and matches in footnote, endnote, or comment stories — and selected tracked changes outside the resolvable set: property revisions (w:rPr/w:ins paragraph marks, w:trPr/w:del rows), moves, every *PrChange, revisions wrapping rows or block content, and revisions in footnote, endnote, or comment stories (bounded)"},{"name":"unsupported_total","type":"number","required":true,"description":"unsupported matches before bounding"},{"name":"conflicts","type":"array(finding)","required":true,"description":"paragraph locations where two operations match overlapping text, where accept_revision and reject_revision both select one tracked change, or where a selected revision contains another revision (bounded)"},{"name":"conflicts_total","type":"number","required":true,"description":"overlapping match sites before bounding"},{"name":"locations","type":"array(finding)","required":true,"description":"canonical paragraph location and needle for each rewritten span, or the accepted/rejected revision for each resolved tracked change (bounded)"},{"name":"locations_truncated","type":"boolean","required":true,"description":"whether locations omitted later sites"},{"name":"stories_scanned","type":"array(string)","required":true,"description":"the stories the edit scanned: /body, then /header[K] and /footer[K]"},{"name":"transaction","type":"object","required":true,"description":"office.transaction/2 report; preservation is authoritative. Matches and revisions are resolved against the ORIGINAL snapshot — operations never see each other's output — and applied as byte-span edits, so all unrelated OOXML survives; a replacement inherits the formatting of the run the match started in; accepting an insertion or rejecting a deletion unwraps the element and keeps its runs (each w:delText is renamed back to w:t in place), while rejecting an insertion or accepting a deletion removes the element and its content; nothing is published on any refusal, and a zero-change run reuses the exact input bytes"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"annotate","summary":"Mutate DOCX comments through a strict annotation script","usage":"office annotate FILE SCRIPT.json --out OUT.docx [--dry-run] [--overwrite] [--json|--jsonl]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"existing .docx package (never modified in place)"},{"name":"script","type":"docx.annotation-batch/1-file","required":true,"description":"strict comment add/reply/resolve/unresolve script; body is plain paragraphs, anchors are /docx/body/p[K], references are tagged {label} or {comment_id}"},{"name":"out","type":"path","required":true,"description":"destination .docx; created atomically, refused when present unless --overwrite"},{"name":"dry-run","type":"boolean","required":false,"description":"run the full fold and validation without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"},{"name":"jsonl","type":"boolean","required":false,"description":"emit one office.output/1 line"}],"outputs":[{"name":"schema","type":"literal(office.docx.annotation-batch/1)","required":true,"description":"versioned annotation-batch result schema"},{"name":"ops_applied","type":"number","required":true,"description":"comment ops folded"},{"name":"results","type":"array(object)","required":true,"description":"per op: op, comment_id, done, anchor + anchor_to (comment_add; anchor_to only on a paragraph range), target (reply/resolve/unresolve) — all bounded"},{"name":"labels","type":"array(object)","required":true,"description":"same-script label -> minted comment_id map"},{"name":"changed_parts","type":"array(string)","required":true,"description":"the union changed-part manifest across every op"},{"name":"transaction","type":"object","required":true,"description":"office.transaction/2 report; preservation is authoritative. Comment ops fold over the source-pinned D1 edit session one snapshot at a time; the document part gains only the narrow comment-anchor markers (the body text is never wholesale-rewritten), while the comment, content-type, and relationship parts are added or updated as the comments require; nothing is published on any refusal"}],"output_modes":["human","json","jsonl"],"variants":[]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"batch","summary":"Apply a strict operation script transactionally (XLSX mutate, DOCX fresh author)","usage":"office batch TARGET SCRIPT [--format xlsx|docx] [--out FILE] [--dry-run] [--overwrite] [--json]","formats":["docx"],"aliases":[],"inputs":[],"outputs":[],"output_modes":["human","json"],"variants":[{"name":"docx","usage":"office batch --format docx TARGET SCRIPT [--dry-run] [--overwrite] [--json]","result_schema":"office.docx.batch/1","inputs":[{"name":"target","type":"path","required":true,"description":"new .docx destination (fresh authoring; never mutates an existing file)"},{"name":"script","type":"docx.batch/2-file","required":true,"description":"strict bounded UTF-8 authoring script"},{"name":"dry-run","type":"boolean","required":false,"description":"validate without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing destination"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"ops","type":"number","required":true,"description":"authoring ops applied"},{"name":"comments","type":"number","required":true,"description":"comment ops applied"},{"name":"footnotes","type":"number","required":true,"description":"footnote refs authored"},{"name":"endnotes","type":"number","required":true,"description":"endnote refs authored"},{"name":"headers","type":"number","required":true,"description":"header stories authored"},{"name":"footers","type":"number","required":true,"description":"footer stories authored"},{"name":"transaction","type":"office.transaction/2","required":true,"description":"validation, preservation, and publication report"}],"constraints":["format=docx","preferred-schema=docx.batch/2","accepts-schema=docx.batch/1","output-extension=.docx","fresh-authoring-only","create-new-by-default","out-not-accepted","transactional-publication","bounded-candidate-package","comments-and-notes-require=docx.batch/2","headers-footers-require=docx.batch/2","header-footer-variants=default|first|even","header-footer-content=plain-blocks-and-fields","fields=PAGE|NUMPAGES","max-image-bytes=8388608","max-total-image-bytes=33554432"],"actions":[],"output_modes":["human","json"]}]}
      #|{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"raw","summary":"Inventory, read, and atomically edit validated OOXML parts","usage":"office raw <list|read|replace|edit> ...","formats":["docx"],"aliases":[],"inputs":[{"name":"operation","type":"enum(list|read|replace|edit)","required":true,"description":"bounded raw OOXML operation"}],"outputs":[],"output_modes":["human","json","base64","file"],"variants":[{"name":"list","usage":"office raw list FILE [--json]","result_schema":"office.raw.inventory/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"format","type":"literal(docx)","required":true,"description":"structurally verified package format"},{"name":"part_count","type":"integer","required":true,"description":"number of inventoried package parts"},{"name":"parts","type":"array(object{name:path,content_type:string,kind:enum(xml|binary),size:integer,aliases:array(string)})","required":true,"description":"bounded canonical part inventory records"}],"constraints":[],"actions":[],"output_modes":["human","json"]},{"name":"read","usage":"office raw read FILE PART [--json] [--base64 | --output FILE]","result_schema":"office.raw.part/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"part","type":"part-selector","required":true,"description":"/name when unambiguous, alias:/name, or part:/name"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"},{"name":"base64","type":"boolean","required":false,"description":"emit exact payload as base64"},{"name":"output","type":"path","required":false,"description":"create a file with the exact payload"}],"outputs":[{"name":"format","type":"literal(docx)","required":true,"description":"structurally verified package format"},{"name":"part","type":"object{name:path,content_type:string,kind:enum(xml|binary),size:integer,aliases:array(string)}","required":true,"description":"resolved package-part metadata"},{"name":"encoding","type":"enum(xml|base64|binary)","required":true,"description":"selected payload representation"},{"name":"content","type":"string","required":false,"description":"decoded XML text or base64 payload"},{"name":"output","type":"path","required":false,"description":"created payload destination"}],"constraints":["mutually-exclusive(base64,output)","binary-requires(base64|output)","output-create-mode(create-new)"],"actions":[],"output_modes":["human","json","base64","file"]},{"name":"replace","usage":"office raw replace FILE PART (--xml XML | --xml-file FILE) [--out FILE] [--dry-run] [--overwrite] [--json]","result_schema":"office.raw.result/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"part","type":"part-selector","required":true,"description":"existing XML part selector"},{"name":"xml","type":"utf8-xml","required":false,"description":"complete replacement XML document"},{"name":"xml-file","type":"path","required":false,"description":"bounded UTF-8 replacement XML file"},{"name":"out","type":"path","required":false,"description":"separate destination with the same .docx or .xlsx extension as the input"},{"name":"dry-run","type":"boolean","required":false,"description":"validate without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing separate destination"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"change","type":"office.raw.change/1","required":true,"description":"validated raw mutation summary"},{"name":"transaction","type":"office.transaction/2","required":true,"description":"transaction validation and publication report"}],"constraints":["exactly-one(xml,xml-file)","overwrite-requires(out)","out-extension-must-match-input-format","transactional-publication"],"actions":[],"output_modes":["human","json"]},{"name":"edit","usage":"office raw edit FILE PART --path PATH --action ACTION [action arguments] [--namespace PREFIX=URI]... [--all] [--out FILE] [--dry-run] [--overwrite] [--json]","result_schema":"office.raw.result/1","inputs":[{"name":"file","type":"path","required":true,"description":"existing XLSX or DOCX package"},{"name":"part","type":"part-selector","required":true,"description":"existing XML part selector"},{"name":"path","type":"office.raw.path/1","required":true,"description":"bounded namespace-aware element selector"},{"name":"action","type":"enum(append|prepend|insert-before|insert-after|replace|remove|set-attribute)","required":true,"description":"bounded edit action"},{"name":"xml","type":"utf8-xml-element","required":false,"description":"one self-contained XML element"},{"name":"xml-file","type":"path","required":false,"description":"bounded UTF-8 XML element file"},{"name":"attribute","type":"qname","required":false,"description":"set-attribute target name"},{"name":"value","type":"string","required":false,"description":"set-attribute exact decoded value"},{"name":"namespace","type":"array(PREFIX=URI)","required":false,"description":"repeatable selector namespace overrides"},{"name":"all","type":"boolean","required":false,"description":"allow multiple bounded matches"},{"name":"out","type":"path","required":false,"description":"separate destination with the same .docx or .xlsx extension as the input"},{"name":"dry-run","type":"boolean","required":false,"description":"validate without publishing"},{"name":"overwrite","type":"boolean","required":false,"description":"replace an existing separate destination"},{"name":"json","type":"boolean","required":false,"description":"emit office.output/1 JSON"}],"outputs":[{"name":"change","type":"office.raw.change/1","required":true,"description":"validated raw mutation summary"},{"name":"transaction","type":"office.transaction/2","required":true,"description":"transaction validation and publication report"}],"constraints":["mutually-exclusive(xml,xml-file)","element-actions-require(exactly-one(xml,xml-file))","set-attribute-requires(attribute,value)","remove-forbids(xml,xml-file,attribute,value)","overwrite-requires(out)","flag-looking-values-require-attached-syntax","out-extension-must-match-input-format","transactional-publication"],"actions":[{"name":"append","requires":["exactly-one(xml,xml-file)"],"forbids":["attribute","value"],"restrictions":[]},{"name":"prepend","requires":["exactly-one(xml,xml-file)"],"forbids":["attribute","value"],"restrictions":[]},{"name":"insert-before","requires":["exactly-one(xml,xml-file)"],"forbids":["attribute","value"],"restrictions":["path-must-not-select-document-element"]},{"name":"insert-after","requires":["exactly-one(xml,xml-file)"],"forbids":["attribute","value"],"restrictions":["path-must-not-select-document-element"]},{"name":"replace","requires":["exactly-one(xml,xml-file)"],"forbids":["attribute","value"],"restrictions":[]},{"name":"remove","requires":[],"forbids":["xml","xml-file","attribute","value"],"restrictions":["path-must-not-select-document-element"]},{"name":"set-attribute","requires":["attribute","value"],"forbids":["xml","xml-file"],"restrictions":[]}],"output_modes":["human","json"]}]}
    ),
  )
}

///|
test "capability fingerprint and inventory ordering are deterministic" {
  inspect(
    @office.capability_fingerprint(),
    content=(
      #|crc32:9257489d
    ),
  )
  let first = @office.capabilities_data().stringify()
  let second = @office.capabilities_data().stringify()
  assert_eq(first, second)
  let parsed = @json.parse(first)
  assert_eq(parsed.stringify(), first)
}

///|
test "capability operation queries do not leak unrelated records" {
  let data = @office.capabilities_data(format=Docx, operation="IDENTIFY")
  inspect(
    data.stringify(),
    content=(
      #|{"schema":"office.capabilities/2","fingerprint":"crc32:9257489d","records":[{"schema":"office.capability/2","fingerprint":"crc32:9257489d","kind":"command","name":"identify","summary":"Identify a structurally valid XLSX or DOCX package","usage":"office identify <file> [--json]","formats":["docx"],"aliases":[],"inputs":[{"name":"file","type":"path","required":true,"description":"path to an XLSX or DOCX package"},{"name":"json","type":"boolean","required":false,"description":"emit one office.output/1 JSON document"}],"outputs":[{"name":"file","type":"path","required":true,"description":"the input path exactly as supplied"},{"name":"format","type":"literal(docx)","required":true,"description":"the structurally verified package format"}],"output_modes":["human","json"],"variants":[]}],"format":"docx","operation":"identify"}
    ),
  )
}
