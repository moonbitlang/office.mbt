{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "result_path",
    "targets",
    "gaps"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "BASELINE PASS",
        "BASELINE FAIL"
      ]
    },
    "result_path": {
      "type": "string",
      "const": "probe-result.md"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "wasm"
      ],
      "properties": {
        "native": {
          "$ref": "#/$defs/target"
        },
        "wasm": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "summary"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xlsx",
        "docx"
      ],
      "properties": {
        "xlsx": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "docx": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    }
  }
}
