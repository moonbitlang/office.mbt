///|
// Generates pdflite/font/standard14/pdf_standard14_kern_pairs.mbt: the
// kerning pairs of the 14 standard fonts by glyph name, from Adobe's Core 14
// AFM files (all their KPX pairs, unencoded glyphs included).
//
// Usage: moon run --target native scripts/gen_standard14_kern_pairs.mbtx -- AFM_DIR
//   AFM_DIR  a directory with Adobe's Core 14 AFM files (Helvetica.afm, ...)
//
// Each font's pairs are written compactly, one line per left glyph:
// `left right value right value ...`; fonts with the same pairs share a
// table.
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

///|
/// The standard fonts and their AFM files.
let fonts : Array[(String, String)] = [
  ("PdfTimesRoman", "Times-Roman"),
  ("PdfTimesBold", "Times-Bold"),
  ("PdfTimesItalic", "Times-Italic"),
  ("PdfTimesBoldItalic", "Times-BoldItalic"),
  ("PdfHelvetica", "Helvetica"),
  ("PdfHelveticaBold", "Helvetica-Bold"),
  ("PdfHelveticaOblique", "Helvetica-Oblique"),
  ("PdfHelveticaBoldOblique", "Helvetica-BoldOblique"),
  ("PdfCourier", "Courier"),
  ("PdfCourierBold", "Courier-Bold"),
  ("PdfCourierOblique", "Courier-Oblique"),
  ("PdfCourierBoldOblique", "Courier-BoldOblique"),
  ("PdfSymbol", "Symbol"),
  ("PdfZapfDingbats", "ZapfDingbats"),
]

///|
/// The compact table of an AFM's KPX pairs: a line per left glyph, in the
/// order the file first names it.
fn compact_pairs(afm : String) -> String {
  let order : Array[String] = []
  let rights : Map[String, Array[String]] = Map([])
  for raw in afm.split("\n") {
    let line = raw.trim().to_owned()
    guard line.has_prefix("KPX ") else { continue }
    let parts = line
      .split(" ")
      .filter(p => !p.is_empty())
      .map(p => p.to_owned())
      .to_array()
    guard parts.length() >= 4 else { continue }
    let left = parts[1]
    if !rights.contains(left) {
      rights[left] = []
      order.push(left)
    }
    rights[left].push(parts[2] + " " + parts[3])
  }
  order
  .map(left => left + " " + rights[left].iter().join(" "))
  .iter()
  .join("\n")
}

///|
fn ident(font : String) -> String {
  font.to_lower().replace_all(old="-", new="_")
}

///|
async fn main {
  let args = @env.args()[1:].to_owned().filter(a => a != "--")
  guard args is [dir] else {
    fail("usage: gen_standard14_kern_pairs.mbtx AFM_DIR")
  }
  let out = StringBuilder()
  out.write_string(
    (
      #|// Generated by scripts/gen_standard14_kern_pairs.mbtx from Adobe's Core 14
      #|// AFM files: their kerning pairs, by glyph name.
      #|// This file constitutes a modification of Adobe's AFM data files. This file
      #|// also constitutes a modification of Adobe's license file.
      #|//
      #|// This file and the 14 PostScript(R) AFM files it accompanies may be used,
      #|// copied, and distributed for any purpose and without charge, with or without
      #|// modification, provided that all copyright notices are retained; that the AFM
      #|// files are not distributed without this file; that all modifications to this
      #|// file or any of the AFM files are prominently noted in the modified file(s);
      #|// and that this paragraph is not modified. Adobe Systems has no responsibility
      #|// or obligation to support the use of the AFM files.
      #|
    ),
  )
  // the tables, each written once, and the font each belongs to
  let tables : Map[String, String] = Map([])
  let dispatch : Array[(String, String?)] = []
  for entry in fonts {
    let (variant, name) = entry
    let afm = @fs.read_file("\{dir}/\{name}.afm").text()
    let table = compact_pairs(afm)
    if table.is_empty() {
      dispatch.push((variant, None))
      continue
    }
    let existing = tables.iter().find_first(t => t.1 == table)
    match existing {
      Some((function, _)) => dispatch.push((variant, Some(function)))
      None => {
        let function = "pdf_standard14_\{ident(name)}_kern_pairs"
        tables[function] = table
        dispatch.push((variant, Some(function)))
        out.write_string("\n///|\nfn \{function}() -> String {\n  (\n")
        for line in table.split("\n") {
          out.write_string("    #|\{line}\n")
        }
        out.write_string("  )\n}\n")
      }
    }
  }
  out.write_string(
    "\n///|\n/// The compact kerning table of a standard font (empty without pairs).\nfn pdf_standard14_kern_pairs_table(font : PdfStandardFont) -> String {\n  match font {\n",
  )
  for entry in dispatch {
    match entry.1 {
      Some(function) => out.write_string("    \{entry.0} => \{function}()\n")
      None => out.write_string("    \{entry.0} => \"\"\n")
    }
  }
  out.write_string("  }\n}\n")
  @fs.write_file(
    "pdflite/font/standard14/pdf_standard14_kern_pairs_data.mbt",
    out.to_string(),
    create_mode=CreateOrTruncate,
  )
  println("\{tables.length()} table(s) for \{fonts.length()} fonts")
}
