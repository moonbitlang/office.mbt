name = "moonbitlang/pdf2md"

version = "0.1.0"

import {
  "moonbitlang/pdflite@0.2.0",
  "moonbitlang/async@0.22.1",
}

readme = "README.md"

repository = "https://github.com/moonbitlang/office.mbt"

license = "Apache-2.0"

keywords = [ "pdf", "markdown", "cli", "extract" ]

description = "Command-line PDF to Markdown extraction built on pdflite."

preferred_target = "native"
