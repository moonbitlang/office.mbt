.DS_Store
_build/
target/
target
.mooncakes/
.moonagent/
# Full excelize Go checkout used by developer parity tooling (not the vendored
# `fixtures/excelize/` test subset, which is committed). Anchored so the bare
# names don't also ignore that subset.
/.repos
..mi
*~
/excelize
__pycache__/
*.pyc
.tools
demos*/
!cmd/demos/
!cmd/demos/moon.pkg
!/demos/
!/demos/**
_mbtexcel_check
/mbtexcel_*.xlsx
.openseek/
tools/**/bin/
tools/**/obj/
docx2html/docx/zz_corpus_shadow_*_wbtest.mbt
.claude

# Cram failure artifacts: the runner writes these beside the .t file on a
# mismatch, and one was committed by accident once.
*.t.new
*.t.err
