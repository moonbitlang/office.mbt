///|
fn hex_bytes(hex : String) -> Bytes {
  let digit = (c : Char) => {
    let c = c.to_int()
    if c >= 'a'.to_int() {
      c - 'a'.to_int() + 10
    } else {
      c - '0'.to_int()
    }
  }
  let out : Array[Byte] = []
  let digits = hex.to_array().filter(c => c != '\n')
  for i = 0; i + 1 < digits.length(); i = i + 2 {
    out.push((digit(digits[i]) * 16 + digit(digits[i + 1])).to_byte())
  }
  Bytes::from_array(out)
}
