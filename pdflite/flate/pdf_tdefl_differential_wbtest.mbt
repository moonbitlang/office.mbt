///|
// The differential: the MoonBit tdefl against the vendored miniz, same input,
// same level, byte for byte.
//
// This is the only test that can settle the port. Everything else -- the
// Huffman cases, the round trips, the frozen vectors -- narrows where a
// divergence could be hiding; this says whether one exists. It runs on native
// only, because that is the one backend where miniz exists to be compared
// against, and it uses the existing FFI rather than new C.
//
// A failure here means the port and the C disagree, and the port is wrong.
// There is no reading where the C gets renegotiated.

///|
/// miniz's own answer for `data` at `level`.
fn miniz_compress(data : Bytes, level : Int) -> Bytes raise {
  let status = Ref::{ val: 0 }
  let out = pdf_flate_zlib_encode_ffi(data, level, status)
  assert_eq(status.val, 1, msg="miniz refused to compress at level \{level}")
  out
}

///|
test "the ported tdefl reproduces miniz byte for byte" {
  let mut compared = 0
  for entry in determinism_corpus() {
    let (name, input) = entry
    for level in determinism_levels() {
      let ours = tdefl_compress_zlib(input, level)
      let theirs = miniz_compress(input, level)
      assert_eq(
        ours.length(),
        theirs.length(),
        msg="\{name} at level \{level}: length differs",
      )
      assert_eq(ours, theirs, msg="\{name} at level \{level}: bytes differ")
      compared = compared + 1
    }
  }
  assert_true(compared >= 30)
}

///|
/// The corpus above is hand-aimed at window boundaries. This is the other
/// axis: generated input at every level, including the ones the fixed corpus
/// does not pin, driven through `@quickcheck.check` so a divergence arrives
/// already shrunk to a minimal counterexample rather than as a 4 KiB blob.
///
/// Shrinking is the reason this is worth having. A byte comparison reports
/// only "different", and finding out *where* by hand across an LZ77 window is
/// exactly the debugging this port cannot afford.
test "the ported tdefl reproduces miniz on generated input at every level" {
  @quickcheck.check(
    (seeds : Array[Int]) => {
      // Repeat each generated byte a generated number of times, so inputs
      // reach the length where matches, block boundaries and the window
      // actually come into play. A flat map of the seeds would cap the input
      // at quickcheck's array size, which is far too small to exercise any of
      // that.
      let bytes = []
      for value in seeds {
        let symbol = ((value & 0xFF) % 6).to_byte()
        let run = ((value >> 8) & 0x7F) + 1
        for _ in 0..<run {
          bytes.push(symbol)
        }
      }
      let input = Bytes::from_array(bytes)
      let mut agreed = true
      for level in 0..<=9 {
        let ours = tdefl_compress_zlib(input, level)
        let theirs = miniz_compress(input, level)
        if ours != theirs {
          agreed = false
        }
      }
      agreed
    },
    count=48,
    seed=0x7464_65666C70UL,
  )
}

///|
/// Pseudorandom bytes with no exploitable structure, as a source of input that
/// compresses badly and therefore produces one token per byte.
fn tdefl_incompressible(count : Int) -> Bytes {
  let out = Array::make(count, b'\x00')
  let mut state = 0x2545F491
  for i in 0..<count {
    state = (state * 1103515245 + 12345) & 0x7FFFFFFF
    out[i] = ((state >> 16) & 0xFF).to_byte()
  }
  Bytes::from_array(out)
}

///|
/// Inputs large enough to force the LZ code buffer past its capacity, so the
/// parser flushes mid-stream and the port has to agree with the C across a
/// block boundary as well as within one.
///
/// The previous version of this test did not do that, and said it did. It used
/// a 997-byte-periodic input, which produces long matches and therefore very
/// few tokens, so 300 KB of it never approached the 64 KiB token buffer. What
/// fills that buffer is input that compresses *badly*: roughly one token per
/// byte, so ~200 KB of pseudorandom data crosses it several times over.
///
/// Level 0 is included deliberately. It forces every block raw, so this is
/// also the only place multi-block forced-raw behaviour is compared.
test "the ported tdefl agrees with miniz across block boundaries" {
  let input = tdefl_incompressible(200000)
  for level in [0, 1, 6, 9] {
    let ours = tdefl_compress_zlib(input, level)
    let theirs = miniz_compress(input, level)
    assert_eq(
      ours.length(),
      theirs.length(),
      msg="200k at level \{level}: length differs",
    )
    assert_eq(ours, theirs, msg="200k at level \{level}: bytes differ")
  }
}

///|
/// Input that fills the LZ code buffer without first tripping the
/// poor-compression heuristic, which is the only way to reach the capacity
/// branch at all.
///
/// The two flush reasons compete. A literal-heavy stream spends about 1.125
/// code bytes per input byte, and the heuristic fires once
/// `code_bytes * 115 >> 7 >= input_bytes` past 31 KiB -- which that ratio
/// satisfies immediately. So incompressible input can never fill the 64 KiB
/// buffer; it is flushed at 31 KiB every time.
///
/// What reaches capacity is input that compresses *moderately*: enough
/// matches to keep the ratio well under 1.113, but short enough matches that
/// tokens still accumulate. Short repeats from a small dictionary do that.
fn tdefl_moderately_compressible(count : Int) -> Bytes {
  let out = Array::make(count, b'\x00')
  let mut state = 0x9E3779B9
  let mut i = 0
  while i < count {
    state = (state * 1103515245 + 12345) & 0x7FFFFFFF
    // a short run drawn from a small alphabet: matchable, but not so long
    // that the token count collapses
    let symbol = (((state >> 16) & 0x0F) + 97).to_byte()
    let run = ((state >> 8) & 0x03) + 3
    let mut k = 0
    while k < run && i < count {
      out[i] = symbol
      i = i + 1
      k = k + 1
    }
  }
  Bytes::from_array(out)
}

///|
/// The capacity branch, reached and shown to have been reached.
///
/// An earlier version asserted only `block_index > 1`, which is true of any
/// multi-block stream and was in fact being satisfied by the *other* branch.
/// Counting capacity flushes separately is what makes this test about the path
/// it names.
test "the differential reaches the code-buffer capacity flush" {
  let input = tdefl_moderately_compressible(400000)
  let state = TdeflState::new(6)
  state.adler32 = tdefl_adler32(input)
  state.compress_input(input, 6)
  state.flush_block(6, true)
  assert_true(state.capacity_flushes > 0)
  assert_true(state.block_index > 1)
  // and the port still agrees with the C on that stream
  for level in [1, 6, 9] {
    let ours = tdefl_compress_zlib(input, level)
    let theirs = miniz_compress(input, level)
    assert_eq(ours, theirs, msg="capacity-flushing input at level \{level}")
  }
}

///|
/// The other branch, for contrast: incompressible input flushes on the
/// poor-compression heuristic and never reaches capacity.
test "incompressible input flushes on the heuristic, not on capacity" {
  let input = tdefl_incompressible(200000)
  let state = TdeflState::new(6)
  state.adler32 = tdefl_adler32(input)
  state.compress_input(input, 6)
  state.flush_block(6, true)
  assert_eq(state.capacity_flushes, 0)
  assert_true(state.block_index > 1)
}

///|
/// The port's output must also be readable, which the byte comparison above
/// does not by itself establish: two implementations can agree on something
/// neither can decode.
test "the ported tdefl produces streams miniz can read back" {
  for entry in determinism_corpus() {
    let (name, input) = entry
    for level in determinism_levels() {
      let ours = tdefl_compress_zlib(input, level)
      miniz_accepts(ours, input, "\{name} at level \{level} through the port")
    }
  }
}
