///|
// The differential: the MoonBit tdefl against the vendored miniz, same input,
// same level, byte for byte.
//
// This is the only test that can settle the port. Everything else -- the
// Huffman cases, the round trips, the frozen vectors -- narrows where a
// divergence could be hiding; this says whether one exists. It runs on native
// only, because that is the one backend where miniz exists to be compared
// against, and it uses the existing FFI rather than new C.
//
// A failure here means the port and the C disagree, and the port is wrong.
// There is no reading where the C gets renegotiated.

///|
/// miniz's own answer for `data` at `level`.
fn miniz_compress(data : Bytes, level : Int) -> Bytes raise {
  let status = Ref::{ val: 0 }
  let out = pdf_flate_zlib_encode_ffi(data, level, status)
  assert_eq(status.val, 1, msg="miniz refused to compress at level \{level}")
  out
}

///|
test "the ported tdefl reproduces miniz byte for byte" {
  let mut compared = 0
  for entry in determinism_corpus() {
    let (name, input) = entry
    for level in determinism_levels() {
      let ours = tdefl_compress_zlib(input, level)
      let theirs = miniz_compress(input, level)
      assert_eq(
        ours.length(),
        theirs.length(),
        msg="\{name} at level \{level}: length differs",
      )
      assert_eq(ours, theirs, msg="\{name} at level \{level}: bytes differ")
      compared = compared + 1
    }
  }
  assert_true(compared >= 30)
}

///|
/// The corpus above is hand-aimed at window boundaries. This is the other
/// axis: generated input at every level, including the ones the fixed corpus
/// does not pin, driven through `@quickcheck.check` so a divergence arrives
/// already shrunk to a minimal counterexample rather than as a 4 KiB blob.
///
/// Shrinking is the reason this is worth having. A byte comparison reports
/// only "different", and finding out *where* by hand across an LZ77 window is
/// exactly the debugging this port cannot afford.
test "the ported tdefl reproduces miniz on generated input at every level" {
  @quickcheck.check(
    (seeds : Array[Int]) => {
      // Repeat each generated byte a generated number of times, so inputs
      // reach the length where matches, block boundaries and the window
      // actually come into play. A flat map of the seeds would cap the input
      // at quickcheck's array size, which is far too small to exercise any of
      // that.
      let bytes = []
      for value in seeds {
        let symbol = ((value & 0xFF) % 6).to_byte()
        let run = ((value >> 8) & 0x7F) + 1
        for _ in 0..<run {
          bytes.push(symbol)
        }
      }
      let input = Bytes::from_array(bytes)
      let mut agreed = true
      for level in 0..<=9 {
        let ours = tdefl_compress_zlib(input, level)
        let theirs = miniz_compress(input, level)
        if ours != theirs {
          agreed = false
        }
      }
      agreed
    },
    count=48,
    seed=0x7464_65666C70UL,
  )
}

///|
/// A large, highly structured real input: the PDF fixture bytes this library
/// actually compresses. Long enough to cross the 64 KiB code-buffer flush and
/// the 32 KiB window, which the generated inputs mostly are not.
test "the ported tdefl reproduces miniz on a large real input" {
  // built rather than read, so the test stays hermetic: a long period with
  // drifting content defeats a trivial whole-input match while still
  // compressing well and crossing every internal boundary
  let bytes = []
  for i in 0..<300000 {
    let phase = i % 997
    bytes.push((phase * 7 % 61 + 32).to_byte())
  }
  let input = Bytes::from_array(bytes)
  for level in [1, 6, 9] {
    let ours = tdefl_compress_zlib(input, level)
    let theirs = miniz_compress(input, level)
    assert_eq(ours.length(), theirs.length(), msg="300k at level \{level}")
    assert_eq(ours, theirs, msg="300k bytes at level \{level}")
  }
}

///|
/// The port's output must also be readable, which the byte comparison above
/// does not by itself establish: two implementations can agree on something
/// neither can decode.
test "the ported tdefl produces streams miniz can read back" {
  for entry in determinism_corpus() {
    let (name, input) = entry
    for level in determinism_levels() {
      let ours = tdefl_compress_zlib(input, level)
      miniz_accepts(ours, input, "\{name} at level \{level} through the port")
    }
  }
}
