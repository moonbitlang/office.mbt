        900, 3, 900, 0, 2, 900, 900, 3, 2, 0, 255, 900, 0, 2, 1, 1, 255, 3, 2, 2,
        900, 255, 1, 0, 1, 900, 0, 2, 0, 0, 2, 1, 255, 2, 1, 0, 900, 2, 900, 2, 900,
        2, 3, 3, 17, 1, 2, 17, 1, 1, 0, 17, 2, 900, 0, 1, 0, 17, 2, 3, 0, 17, 3,
        2, 3, 900, 900, 1, 17, 0, 3, 1, 255, 0, 2, 0, 255, 0, 900, 1, 0, 255, 2,
        1, 0, 0, 1, 3, 3, 17, 900, 1, 0, 17, 0, 17, 3, 900, 1, 255, 0, 1, 1, 1, 17,
        0, 255, 1, 255, 2, 1, 3, 17, 1, 1, 900, 255, 1, 0, 2, 3, 0, 0, 0, 1, 1, 1,
        1, 0, 1, 2, 255, 0, 0, 0, 900, 17, 255, 0, 0, 17, 0, 1, 0, 3, 17, 2, 0, 0,
        17, 0, 17, 17, 17, 1, 900, 17, 900,
      ],
      [
        15, 15, 15, 0, 15, 15, 8, 15, 15, 0, 15, 7, 0, 7, 15, 12, 7, 15, 7, 6, 15,
        15, 15, 15, 15, 15, 15, 0, 15, 0, 15, 0, 15, 15, 15, 0, 7, 6, 7, 15, 15,
        0, 0, 15, 7, 15, 0, 12, 15, 0, 12, 15, 15, 15, 15, 0, 15, 0, 0, 0, 15, 12,
        15, 12, 15, 15, 11, 15, 11, 0, 15, 11, 11, 15, 15, 6, 0, 15, 0, 11, 0, 15,
        15, 15, 6, 7, 6, 0, 6, 11, 11, 15, 0, 11, 15, 0, 15, 15, 15, 15, 15, 6, 7,
        15, 15, 0, 15, 15, 0, 6, 7, 6, 15, 15, 15, 11, 15, 0, 11, 15, 15, 0, 15,
        15, 5, 15, 15, 15, 15, 15, 5, 15, 5, 0, 15, 5, 5, 15, 15, 0, 7, 5, 0, 15,
        15, 15, 7, 15, 15, 15, 5, 7, 15, 0, 15, 5, 0, 15, 0, 0, 15, 15, 7, 15, 15,
        0, 5, 15, 5, 15, 5, 15, 15, 15, 11, 15, 15, 11, 15, 15, 0, 11, 15, 5, 0,
        15, 0, 11, 15, 15, 0, 11, 15, 15, 15, 5, 5, 15, 11, 0, 15, 15, 7, 0, 15,
        0, 7, 0, 5, 15, 0, 7, 15, 15, 0, 0, 15, 15, 15, 11, 5, 15, 0, 11, 0, 11,
        15, 5, 15, 7, 0, 15, 15, 15, 11, 0, 7, 15, 7, 15, 15, 15, 11, 15, 15, 5,
        7, 15, 0, 15, 15, 0, 0, 0, 15, 15, 15, 15, 0, 15, 15, 7, 0, 0, 0, 5, 11,
        7, 0, 0, 11, 0, 15, 0, 15, 11, 15, 0, 0, 11, 0, 11, 11, 11, 15, 5, 11, 5,
      ],
    ),
  ]
  for entry in cases {
    let (freqs, expected) = entry
    // driven through the state the compressor actually uses, so this tests
    // the shipping path rather than a duplicate kept for testability
    let state = TdeflState::new(6)
    for i, freq in freqs {
      state.huff_count[0][i] = freq
    }
    state.optimize_huffman_table(0, freqs.length(), 15, false)
    let got = []
    for i in 0..<freqs.length() {
      got.push(state.huff_code_sizes[0][i])
    }
    assert_eq(got, expected)
  }
  // a corpus that shrank to nothing would pass without comparing anything
  assert_true(cases.length() >= 30)
}
