///|
/// The compact kerning table of a standard font (empty without pairs).
fn pdf_standard14_kern_pairs_table(font : PdfStandardFont) -> String {
  match font {
    PdfTimesRoman => pdf_standard14_times_roman_kern_pairs()
    PdfTimesBold => pdf_standard14_times_bold_kern_pairs()
    PdfTimesItalic => pdf_standard14_times_italic_kern_pairs()
    PdfTimesBoldItalic => pdf_standard14_times_bolditalic_kern_pairs()
    PdfHelvetica => pdf_standard14_helvetica_kern_pairs()
    PdfHelveticaBold => pdf_standard14_helvetica_bold_kern_pairs()
    PdfHelveticaOblique => pdf_standard14_helvetica_kern_pairs()
    PdfHelveticaBoldOblique => pdf_standard14_helvetica_bold_kern_pairs()
    PdfCourier => ""
    PdfCourierBold => ""
    PdfCourierOblique => ""
    PdfCourierBoldOblique => ""
    PdfSymbol => ""
    PdfZapfDingbats => ""
  }
}
